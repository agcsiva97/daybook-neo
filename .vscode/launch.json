{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Runserver (Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/daybook_lite/manage.py",
      "args": ["runserver", "daybook.local:8000"],
      "django": true,
      "justMyCode": true,
      "env": {
        "DJANGO_SETTINGS_MODULE": "daybook_lite.settings"
      },
      "console": "integratedTerminal"
    }
  ]
}